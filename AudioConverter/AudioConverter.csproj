<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <AssemblyName>TechArchive Audio Converter</AssemblyName>
    <Company>TechArchive</Company>
    <Authors>TechArchive</Authors>
    <Product>TechArchive Audio Converter</Product>
    <Title>TechArchive Audio Converter</Title>
    <Description>Desktop converter for MP3, FLAC, WAV, AIFF, AAC and other audio formats.</Description>
    <Version>1.0.6</Version>
    <AssemblyVersion>1.0.6.0</AssemblyVersion>
    <FileVersion>1.0.6.0</FileVersion>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <StartupObject>UniversalConverter.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/Models/ConversionOption.cs" Link="Models/ConversionOption.cs" />
    <Compile Include="../Shared/Services/LanguageService.cs" Link="Services/LanguageService.cs" />
    <Compile Include="../Shared/Services/FFmpegHelper.cs" Link="Services/FFmpegHelper.cs" />
    <Compile Include="../Shared/Services/AudioConversionService.cs" Link="Services/AudioConversionService.cs" />
    <Compile Include="../Shared/Services/UpdateDownloadProgressWindow.cs" Link="Services/UpdateDownloadProgressWindow.cs" />
  </ItemGroup>

</Project>
