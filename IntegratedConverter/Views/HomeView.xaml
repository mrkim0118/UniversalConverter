<UserControl x:Class="UniversalConverter.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#EEF2FF">

    <UserControl.Resources>
        <Style x:Key="ToolCard" TargetType="Button">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#C7D2FE"/>
                    <Setter Property="Background" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="28" Padding="28" Margin="0,0,0,18">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1D4ED8" Offset="0"/>
                    <GradientStop Color="#6D28D9" Offset="0.5"/>
                    <GradientStop Color="#DB2777" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="HeroTitle"
                               Text="Universal Converter"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="White"
                               FontFamily="Malgun Gothic"/>
                    <TextBlock x:Name="HeroSubtitle"
                               Text="Open one workspace for image, audio, video, document, and font conversion."
                               Margin="0,10,0,0"
                               FontSize="14"
                               Foreground="#EDE9FE"
                               TextWrapping="Wrap"
                               FontFamily="Malgun Gothic"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <Button x:Name="LangBtn"
                            Content="한국어"
                            Click="LangBtn_Click"
                            Margin="0,0,8,0"
                            Padding="14,8"
                            Cursor="Hand"
                            Background="#E0E7FF"
                            Foreground="#312E81"
                            BorderBrush="#C7D2FE"
                            BorderThickness="1"
                            FontSize="12"
                            FontWeight="SemiBold"
                            FontFamily="Malgun Gothic"/>
                    <Button x:Name="DonateBtn"
                            Content="Donate"
                            Click="DonateBtn_Click"
                            Margin="0,0,8,0"
                            Padding="14,8"
                            Cursor="Hand"
                            Background="#F59E0B"
                            Foreground="White"
                            BorderBrush="#FBBF24"
                            BorderThickness="1"
                            FontSize="12"
                            FontWeight="SemiBold"
                            FontFamily="Malgun Gothic"/>
                    <Button x:Name="WebsiteBtn"
                            Content="Website"
                            Click="WebsiteBtn_Click"
                            Padding="14,8"
                            Cursor="Hand"
                            Background="#312E81"
                            Foreground="White"
                            BorderBrush="#A5B4FC"
                            BorderThickness="1"
                            FontSize="12"
                            FontWeight="SemiBold"
                            FontFamily="Malgun Gothic"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="4,0,4,12">
            <TextBlock x:Name="SectionTitle"
                       Text="Choose a converter"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#111827"
                       FontFamily="Malgun Gothic"/>
            <TextBlock x:Name="SectionSubtitle"
                       Text="Each tool keeps its own specialized options, and you can return here anytime."
                       Margin="0,6,0,0"
                       FontSize="13"
                       Foreground="#6B7280"
                       FontFamily="Malgun Gothic"/>
        </StackPanel>

        <UniformGrid Grid.Row="2" Columns="2">
            <Button Style="{StaticResource ToolCard}" Click="ImageBtn_Click">
                <Border Padding="24">
                    <StackPanel>
                        <Border Width="62" Height="62" CornerRadius="18" Background="#EDE9FE">
                            <TextBlock Text="🖼" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="ImageTitle"
                                   Text="Image Converter"
                                   Margin="0,18,0,0"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   FontFamily="Malgun Gothic"/>
                        <TextBlock x:Name="ImageDesc"
                                   Text="JPG, PNG, WEBP, GIF, TIFF, AVIF, PDF and more."
                                   Margin="0,8,0,0"
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap"
                                   FontFamily="Malgun Gothic"/>
                    </StackPanel>
                </Border>
            </Button>

            <Button Style="{StaticResource ToolCard}" Click="AudioBtn_Click">
                <Border Padding="24">
                    <StackPanel>
                        <Border Width="62" Height="62" CornerRadius="18" Background="#DBEAFE">
                            <TextBlock Text="🎵" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="AudioTitle"
                                   Text="Audio Converter"
                                   Margin="0,18,0,0"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   FontFamily="Malgun Gothic"/>
                        <TextBlock x:Name="AudioDesc"
                                   Text="MP3, FLAC, WAV, AIFF, AAC with FFmpeg-powered conversion."
                                   Margin="0,8,0,0"
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap"
                                   FontFamily="Malgun Gothic"/>
                    </StackPanel>
                </Border>
            </Button>

            <Button Style="{StaticResource ToolCard}" Click="VideoBtn_Click">
                <Border Padding="24">
                    <StackPanel>
                        <Border Width="62" Height="62" CornerRadius="18" Background="#D1FAE5">
                            <TextBlock Text="🎬" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="VideoTitle"
                                   Text="Video Converter"
                                   Margin="0,18,0,0"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   FontFamily="Malgun Gothic"/>
                        <TextBlock x:Name="VideoDesc"
                                   Text="MP4, AVI, WEBM, MKV, FLV, MPEG with quality and resolution controls."
                                   Margin="0,8,0,0"
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap"
                                   FontFamily="Malgun Gothic"/>
                    </StackPanel>
                </Border>
            </Button>

            <Button Style="{StaticResource ToolCard}" Click="DocumentBtn_Click">
                <Border Padding="24">
                    <StackPanel>
                        <Border Width="62" Height="62" CornerRadius="18" Background="#FEF3C7">
                            <TextBlock Text="📄" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="DocumentTitle"
                                   Text="Document Converter"
                                   Margin="0,18,0,0"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   FontFamily="Malgun Gothic"/>
                        <TextBlock x:Name="DocumentDesc"
                                   Text="PDF, DOCX, HTML, TXT, CSV, JSON, XML, XLS and more."
                                   Margin="0,8,0,0"
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap"
                                   FontFamily="Malgun Gothic"/>
                    </StackPanel>
                </Border>
            </Button>

            <Button Style="{StaticResource ToolCard}" Click="FontBtn_Click">
                <Border Padding="24">
                    <StackPanel>
                        <Border Width="62" Height="62" CornerRadius="18" Background="#FCE7F3">
                            <TextBlock Text="🔤" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="FontTitle"
                                   Text="Font Converter"
                                   Margin="0,18,0,0"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   FontFamily="Malgun Gothic"/>
                        <TextBlock x:Name="FontDesc"
                                   Text="TTF, OTF, WOFF, WOFF2, EOT conversion in one place."
                                   Margin="0,8,0,0"
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap"
                                   FontFamily="Malgun Gothic"/>
                    </StackPanel>
                </Border>
            </Button>
        </UniformGrid>
    </Grid>
</UserControl>
