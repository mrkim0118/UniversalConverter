<UserControl x:Class="UniversalConverter.Views.VideoConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">

    <UserControl.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#ECFDF5"/>
                    <Setter Property="BorderBrush" Value="#6EE7B7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FilterBtn" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#ECFDF5"/>
                    <Setter Property="BorderBrush" Value="#6EE7B7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FilterBtnActive" TargetType="Border">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#059669"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="SettingSep" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Fill" Value="#E5E7EB"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0"/>
        </Style>
        <Style x:Key="GreenProgressBar" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2">
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left" CornerRadius="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <Border Grid.Row="0" Padding="0,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#059669" Offset="0"/>
                    <GradientStop Color="#047857" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="20,0">
                <Button x:Name="BackBtn" Content="← 돌아가기" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Cursor="Hand"
                        Click="Back_Click"
                        Background="Transparent" Foreground="#A7F3D0"
                        BorderThickness="0" FontSize="13"
                        FontFamily="Malgun Gothic" Padding="8,4"/>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" Text="🎬  비디오 포맷 변환기"
                               FontSize="20" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"
                               FontFamily="Malgun Gothic"/>
                    <TextBlock Text="MP4 · AVI · WEBM · MKV · FLV · MPEG"
                               FontSize="11" Foreground="#A7F3D0"
                               HorizontalAlignment="Center" Margin="0,4,0,0"
                               FontFamily="Malgun Gothic"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="LangBtn" Content="EN" Click="LangBtn_Click"
                            Cursor="Hand" Margin="0,0,8,0" Padding="12,6"
                            Background="#D1FAE5" Foreground="#065F46"
                            BorderBrush="#6EE7B7" BorderThickness="1"
                            FontSize="11" FontWeight="SemiBold"
                            FontFamily="Malgun Gothic"/>
                    <Button x:Name="DonateBtn" Content="기부" Click="DonateBtn_Click"
                            Cursor="Hand" Margin="0,0,8,0" Padding="12,6"
                            Background="#F59E0B" Foreground="White"
                            BorderBrush="#FBBF24" BorderThickness="1"
                            FontSize="11" FontWeight="SemiBold"
                            FontFamily="Malgun Gothic"/>
                    <Button x:Name="WebsiteBtn" Content="홈페이지" Click="WebsiteBtn_Click"
                            Cursor="Hand" Padding="12,6"
                            Background="#047857" Foreground="White"
                            BorderBrush="#34D399" BorderThickness="1"
                            FontSize="11" FontWeight="SemiBold"
                            FontFamily="Malgun Gothic"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ FFmpeg 상태 배너 ═══ -->
        <Border x:Name="FFmpegBanner" Grid.Row="1" Margin="24,10,24,0"
                CornerRadius="8" Padding="16,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FFmpegStatusText" Grid.Column="0"
                           FontSize="13" VerticalAlignment="Center"
                           FontFamily="Malgun Gothic" TextWrapping="Wrap"/>
                <Button x:Name="FFmpegActionBtn" Grid.Column="1"
                        Content="FFmpeg 자동 설치"
                        Click="FFmpegInstall_Click"
                        Padding="16,8" Cursor="Hand"
                        FontFamily="Malgun Gothic" FontSize="12" FontWeight="SemiBold"
                        Background="#059669" Foreground="White"
                        BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- ═══ Search ═══ -->
        <Border Grid.Row="2" Margin="24,12,24,4" CornerRadius="6"
                Background="White" BorderBrush="#D1D5DB" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔍" FontSize="16"
                           VerticalAlignment="Center" Margin="14,0,6,0"/>
                <TextBox x:Name="SearchBox" Grid.Column="1"
                         BorderThickness="0" FontSize="14"
                         Padding="6,10" Background="Transparent"
                         FontFamily="Malgun Gothic" Foreground="#9CA3AF"
                         Text="변환 형식 검색  (예: MP4, AVI, WEBM ...)"
                         GotFocus="SearchBox_GotFocus"
                         LostFocus="SearchBox_LostFocus"
                         TextChanged="SearchBox_TextChanged"/>
                <TextBlock x:Name="CountLabel" Grid.Column="2"
                           FontSize="12" Foreground="#9CA3AF"
                           VerticalAlignment="Center" Margin="0,0,14,0"
                           FontFamily="Malgun Gothic"/>
            </Grid>
        </Border>

        <!-- ═══ 변환 설정 패널 ═══ -->
        <Border Grid.Row="3" Margin="24,4,24,4" CornerRadius="8"
                Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                Padding="14,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- 제목 -->
                <TextBlock x:Name="SettingsPanelTitle" Text="⚙  변환 설정" FontSize="12" FontWeight="SemiBold"
                           Foreground="#374151" FontFamily="Malgun Gothic"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>

                <Rectangle Style="{StaticResource SettingSep}"/>

                <!-- CRF (품질) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="CrfSettingLabel" Text="품질 (CRF)" Style="{StaticResource SettingLabel}">
                        <TextBlock.ToolTip>H.264/VP9 CRF 값 (0=최고화질, 51=최저화질, 기본 23). AVI·FLV·MPEG에는 미적용</TextBlock.ToolTip>
                    </TextBlock>
                    <Slider x:Name="CrfSlider" Width="100" Minimum="0" Maximum="51" Value="23"
                            VerticalAlignment="Center" SmallChange="1" LargeChange="5"
                            ValueChanged="CrfSlider_ValueChanged"/>
                    <TextBlock x:Name="CrfLabel" Text="23" FontSize="11" FontWeight="SemiBold"
                               Foreground="#059669" FontFamily="Malgun Gothic"
                               VerticalAlignment="Center" Margin="6,0,0,0" Width="24"/>
                </StackPanel>

                <Rectangle Style="{StaticResource SettingSep}"/>

                <!-- 인코딩 속도 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="PresetSettingLabel" Text="인코딩 속도" Style="{StaticResource SettingLabel}">
                        <TextBlock.ToolTip>H.264 (MP4·MKV) 인코딩 프리셋. 느릴수록 파일이 작아지고 시간이 더 걸립니다</TextBlock.ToolTip>
                    </TextBlock>
                    <ComboBox x:Name="PresetCombo" FontSize="11" Width="88"
                              VerticalAlignment="Center" FontFamily="Malgun Gothic"
                              SelectedIndex="2">
                        <ComboBoxItem>ultrafast</ComboBoxItem>
                        <ComboBoxItem>fast</ComboBoxItem>
                        <ComboBoxItem>medium</ComboBoxItem>
                        <ComboBoxItem>slow</ComboBoxItem>
                        <ComboBoxItem>veryslow</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <Rectangle Style="{StaticResource SettingSep}"/>

                <!-- 오디오 비트레이트 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="AudioBitrateLabel" Text="오디오 비트레이트" Style="{StaticResource SettingLabel}">
                        <TextBlock.ToolTip>출력 영상에 포함되는 오디오 트랙의 비트레이트 (kbps)</TextBlock.ToolTip>
                    </TextBlock>
                    <ComboBox x:Name="AudioBitrateCombo" FontSize="11" Width="68"
                              VerticalAlignment="Center" FontFamily="Malgun Gothic"
                              SelectedIndex="2">
                        <ComboBoxItem>96</ComboBoxItem>
                        <ComboBoxItem>128</ComboBoxItem>
                        <ComboBoxItem>192</ComboBoxItem>
                        <ComboBoxItem>256</ComboBoxItem>
                        <ComboBoxItem>320</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="kbps" Style="{StaticResource SettingLabel}" Margin="4,0,0,0"/>
                </StackPanel>

                <Rectangle Style="{StaticResource SettingSep}"/>

                <!-- 출력 해상도 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ResolutionSettingLabel" Text="출력 해상도" Style="{StaticResource SettingLabel}">
                        <TextBlock.ToolTip>영상의 세로 해상도를 지정합니다. '원본 유지'는 입력 파일 해상도 그대로 사용</TextBlock.ToolTip>
                    </TextBlock>
                    <ComboBox x:Name="ResolutionCombo" FontSize="11" Width="82"
                              VerticalAlignment="Center" FontFamily="Malgun Gothic"
                              SelectedIndex="0">
                        <ComboBoxItem Tag="">원본 유지</ComboBoxItem>
                        <ComboBoxItem Tag="360">360p</ComboBoxItem>
                        <ComboBoxItem Tag="480">480p</ComboBoxItem>
                        <ComboBoxItem Tag="720">720p</ComboBoxItem>
                        <ComboBoxItem Tag="1080">1080p</ComboBoxItem>
                        <ComboBoxItem Tag="2160">4K (2160p)</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

            </WrapPanel>
        </Border>

        <!-- ═══ Filter tabs ═══ -->
        <ScrollViewer Grid.Row="4" Margin="20,8,20,4"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" Height="62">
            <StackPanel x:Name="FilterPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
        </ScrollViewer>

        <!-- ═══ Card Grid ═══ -->
        <ScrollViewer Grid.Row="5" Margin="16,4,16,8"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="CardsPanel">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}"
                                MouseLeftButtonDown="Card_Click" Tag="{Binding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="44" Height="44"
                                        CornerRadius="6" Margin="0,0,12,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#059669" Offset="0"/>
                                            <GradientStop Color="#047857" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="🎬" FontSize="20"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="13"
                                               FontWeight="Bold" Foreground="#222"
                                               FontFamily="Malgun Gothic"/>
                                    <TextBlock Text="{Binding Description}" FontSize="10.5"
                                               Foreground="#9CA3AF" Margin="0,2,0,0"
                                               FontFamily="Malgun Gothic"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="22"
                                           FontWeight="Bold" Foreground="#059669"
                                           VerticalAlignment="Center" Margin="6,0,2,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ═══ Status bar ═══ -->
        <Border Grid.Row="6" Background="White" Padding="16,8"
                BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <StackPanel>
                <ProgressBar x:Name="ConversionProgress" Height="6" Minimum="0" Maximum="100" Value="0"
                             Visibility="Collapsed" Margin="0,0,0,6"
                             Background="#E5E7EB" Foreground="#22C55E"
                             Style="{StaticResource GreenProgressBar}"/>
                <Grid>
                    <TextBlock x:Name="StatusText" Text="변환할 형식을 선택하세요"
                               FontSize="12" Foreground="#6B7280" FontFamily="Malgun Gothic"/>
                    <TextBlock x:Name="TotalLabel" FontSize="12" Foreground="#9CA3AF"
                               FontFamily="Malgun Gothic" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
