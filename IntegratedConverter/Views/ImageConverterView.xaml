<UserControl x:Class="UniversalConverter.Views.UniversalConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">

    <UserControl.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0EBFF"/>
                    <Setter Property="BorderBrush" Value="#C4B5FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FilterBtn" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0EBFF"/>
                    <Setter Property="BorderBrush" Value="#C4B5FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FilterBtnActive" TargetType="Border">
            <Setter Property="Background" Value="#6C3FC5"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#6C3FC5"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="SettingSep" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Fill" Value="#E5E7EB"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0"/>
        </Style>
        <Style x:Key="GreenProgressBar" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2">
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left" CornerRadius="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <Border Grid.Row="0" Background="#6C3FC5" Padding="0,16">
            <Grid Margin="20,0">
                <Button x:Name="BackBtn" Content="← 돌아가기" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Cursor="Hand"
                        Click="Back_Click"
                        Background="Transparent" Foreground="#D4BBFF"
                        BorderThickness="0" FontSize="13"
                        FontFamily="Malgun Gothic" Padding="8,4"/>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" Text="🖼  이미지 포맷 변환기"
                               FontSize="20" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"
                               FontFamily="Malgun Gothic"/>
                    <TextBlock Text="HEIC · JPG · PNG · PDF · PSD · WEBP · GIF · TIFF · BMP · SVG · AVIF · ICO"
                               FontSize="10" Foreground="#D4BBFF"
                               HorizontalAlignment="Center" Margin="0,4,0,0"
                               FontFamily="Malgun Gothic"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="LangBtn" Content="EN" Click="LangBtn_Click"
                            Cursor="Hand" Margin="0,0,8,0" Padding="12,6"
                            Background="#EDE9FE" Foreground="#5B21B6"
                            BorderBrush="#C4B5FD" BorderThickness="1"
                            FontSize="11" FontWeight="SemiBold"
                            FontFamily="Malgun Gothic"/>
                    <Button x:Name="DonateBtn" Content="기부" Click="DonateBtn_Click"
                            Cursor="Hand" Margin="0,0,8,0" Padding="12,6"
                            Background="#F59E0B" Foreground="White"
                            BorderBrush="#FBBF24" BorderThickness="1"
                            FontSize="11" FontWeight="SemiBold"
                            FontFamily="Malgun Gothic"/>
                    <Button x:Name="WebsiteBtn" Content="홈페이지" Click="WebsiteBtn_Click"
                            Cursor="Hand" Padding="12,6"
                            Background="#6D28D9" Foreground="White"
                            BorderBrush="#A78BFA" BorderThickness="1"
                            FontSize="11" FontWeight="SemiBold"
                            FontFamily="Malgun Gothic"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Search ═══ -->
        <Border Grid.Row="1" Margin="24,12,24,4" CornerRadius="6"
                Background="White" BorderBrush="#D1D5DB" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔍" FontSize="16"
                           VerticalAlignment="Center" Margin="14,0,6,0"/>
                <TextBox x:Name="SearchBox" Grid.Column="1"
                         BorderThickness="0" FontSize="14"
                         Padding="6,10" Background="Transparent"
                         FontFamily="Malgun Gothic" Foreground="#9CA3AF"
                         Text="변환 형식 검색  (예: JPG, PNG, HEIC ...)"
                         GotFocus="SearchBox_GotFocus"
                         LostFocus="SearchBox_LostFocus"
                         TextChanged="SearchBox_TextChanged"/>
                <TextBlock x:Name="CountLabel" Grid.Column="2"
                           FontSize="12" Foreground="#9CA3AF"
                           VerticalAlignment="Center" Margin="0,0,14,0"
                           FontFamily="Malgun Gothic"/>
            </Grid>
        </Border>

        <!-- ═══ 변환 설정 패널 ═══ -->
        <Border Grid.Row="2" Margin="24,4,24,4" CornerRadius="8"
                Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                Padding="14,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- 제목 -->
                <TextBlock x:Name="SettingsPanelTitle" Text="⚙  변환 설정" FontSize="12" FontWeight="SemiBold"
                           Foreground="#374151" FontFamily="Malgun Gothic"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>

                <Rectangle Style="{StaticResource SettingSep}"/>

                <!-- 출력 품질 (JPG·WebP·AVIF) -->
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="QualitySettingLabel" Text="출력 품질" Style="{StaticResource SettingLabel}"/>
                        <Slider x:Name="QualitySlider" Width="110" Minimum="1" Maximum="100" Value="90"
                                VerticalAlignment="Center" SmallChange="1" LargeChange="5"
                                ValueChanged="QualitySlider_ValueChanged"/>
                        <TextBlock x:Name="QualityLabel" Text="90%" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#6C3FC5" FontFamily="Malgun Gothic"
                                   VerticalAlignment="Center" Margin="6,0,0,0" Width="34"/>
                    </StackPanel>
                    <TextBlock x:Name="QualityAppliesLabel" Text="JPG · WebP · AVIF 에만 적용"
                               FontSize="9.5" Foreground="#9CA3AF" FontFamily="Malgun Gothic"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Rectangle Style="{StaticResource SettingSep}"/>

                <!-- DPI -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SettingLabel}">
                        DPI
                        <TextBlock.ToolTip>PDF·SVG·EPS 파일을 이미지로 변환할 때 적용되는 해상도입니다</TextBlock.ToolTip>
                    </TextBlock>
                    <ComboBox x:Name="DpiCombo" FontSize="11" Width="68"
                              VerticalAlignment="Center" FontFamily="Malgun Gothic"
                              SelectedIndex="3">
                        <ComboBoxItem>72</ComboBoxItem>
                        <ComboBoxItem>96</ComboBoxItem>
                        <ComboBoxItem>150</ComboBoxItem>
                        <ComboBoxItem>300</ComboBoxItem>
                        <ComboBoxItem>600</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <Rectangle Style="{StaticResource SettingSep}"/>

                <!-- 투명 배경색 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="BgColorSettingLabel" Text="투명 배경색" Style="{StaticResource SettingLabel}">
                        <TextBlock.ToolTip>JPG·BMP 등 투명도를 지원하지 않는 포맷으로 변환 시 채울 배경색입니다</TextBlock.ToolTip>
                    </TextBlock>
                    <ComboBox x:Name="BgColorCombo" FontSize="11" Width="72"
                              VerticalAlignment="Center" FontFamily="Malgun Gothic"
                              SelectedIndex="0">
                        <ComboBoxItem>흰색</ComboBoxItem>
                        <ComboBoxItem>검정</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

            </WrapPanel>
        </Border>

        <!-- ═══ Filter tabs ═══ -->
        <ScrollViewer Grid.Row="3" Margin="20,4,20,4"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" Height="62">
            <StackPanel x:Name="FilterPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
        </ScrollViewer>

        <!-- ═══ Card Grid ═══ -->
        <ScrollViewer Grid.Row="4" Margin="16,4,16,8"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="CardsPanel">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}"
                                MouseLeftButtonDown="Card_Click" Tag="{Binding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="44" Height="44"
                                        CornerRadius="6" Background="#6C3FC5" Margin="0,0,12,0">
                                    <TextBlock Text="🖼" FontSize="20"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="13"
                                               FontWeight="Bold" Foreground="#222"
                                               FontFamily="Malgun Gothic"/>
                                    <TextBlock Text="{Binding Description}" FontSize="10.5"
                                               Foreground="#9CA3AF" Margin="0,2,0,0"
                                               FontFamily="Malgun Gothic"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="22"
                                           FontWeight="Bold" Foreground="#6C3FC5"
                                           VerticalAlignment="Center" Margin="6,0,2,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ═══ Status bar ═══ -->
        <Border Grid.Row="5" Background="White" Padding="16,8"
                BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <StackPanel>
                <ProgressBar x:Name="ConversionProgress" Height="6" Minimum="0" Maximum="100" Value="0"
                             Visibility="Collapsed" Margin="0,0,0,6"
                             Background="#E5E7EB" Foreground="#22C55E"
                             Style="{StaticResource GreenProgressBar}"/>
                <Grid>
                    <TextBlock x:Name="StatusText" Text="변환할 형식을 선택하세요"
                               FontSize="12" Foreground="#6B7280" FontFamily="Malgun Gothic"/>
                    <TextBlock x:Name="TotalLabel" FontSize="12" Foreground="#9CA3AF"
                               FontFamily="Malgun Gothic" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
