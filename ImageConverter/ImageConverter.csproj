<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <AssemblyName>TechArchive Image Converter</AssemblyName>
    <Company>TechArchive</Company>
    <Authors>TechArchive</Authors>
    <Product>TechArchive Image Converter</Product>
    <Title>TechArchive Image Converter</Title>
    <Description>Desktop converter for JPG, PNG, WEBP, HEIC, PDF, SVG and other image formats.</Description>
    <Version>1.0.5</Version>
    <AssemblyVersion>1.0.5.0</AssemblyVersion>
    <FileVersion>1.0.5.0</FileVersion>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <NoWarn>NU1901;NU1902;NU1903;NU1904</NoWarn>
    <StartupObject>UniversalConverter.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.17.2" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/Models/ConversionOption.cs" Link="Models/ConversionOption.cs" />
    <Compile Include="../Shared/Services/LanguageService.cs" Link="Services/LanguageService.cs" />
    <Compile Include="../Shared/Services/ImageConversionService.cs" Link="Services/ImageConversionService.cs" />
    <Compile Include="../Shared/Services/UpdateDownloadProgressWindow.cs" Link="Services/UpdateDownloadProgressWindow.cs" />
  </ItemGroup>

</Project>
