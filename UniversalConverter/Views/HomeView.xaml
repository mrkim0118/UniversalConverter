<UserControl x:Class="UniversalConverter.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" AllowDrop="True"
             DragOver="Root_DragOver" DragLeave="Root_DragLeave" Drop="Root_Drop">
    <UserControl.Resources>
        <Style x:Key="ToolCard" TargetType="Button" BasedOn="{StaticResource CardButton}">
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="6"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="24,14"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="HeroTitle" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="HeroSubtitle" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="LangBtn" Style="{StaticResource FlatButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Click="LangBtn_Click"/>
            </Grid>
        </Border>

        <!-- Drop zone -->
        <Button x:Name="DropZone" Grid.Row="1" HorizontalAlignment="Stretch" Margin="24,20,24,0" Click="PickFiles_Click" Cursor="Hand"
                FocusVisualStyle="{x:Null}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12"/>
                        <Rectangle x:Name="Dash" StrokeDashArray="4 3" Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="1.5"
                                   RadiusX="12" RadiusY="12"/>
                        <ContentPresenter HorizontalAlignment="Center" Margin="16,26"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentTintBrush}"/>
                            <Setter TargetName="Dash" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentTintBrush}"/>
                            <Setter TargetName="Dash" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="drag">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentTintBrush}"/>
                            <Setter TargetName="Dash" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <StackPanel>
                <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="DropTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock x:Name="DropHint" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Button>

        <TextBlock x:Name="SectionTitle" Grid.Row="2" Margin="30,24,24,6" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

        <!-- Tool cards: one column of five -->
        <UniformGrid Grid.Row="3" Columns="1" Margin="18,0,18,18" VerticalAlignment="Top">
            <Button Style="{StaticResource ToolCard}" Click="ImageBtn_Click">
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="10" Background="#267C3AED">
                        <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#7C3AED"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ImageTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="JPG, PNG, WEBP, HEIC, AVIF, PDF" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolCard}" Click="AudioBtn_Click">
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="10" Background="#262563EB">
                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#2563EB"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AudioTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="MP3, FLAC, WAV, AIFF, AAC" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolCard}" Click="VideoBtn_Click">
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="10" Background="#26059669">
                        <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#059669"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="VideoTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="MP4, MKV, WEBM, AVI, FLV, MPEG" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolCard}" Click="DocumentBtn_Click">
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="10" Background="#26D97706">
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#D97706"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="DocumentTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="PDF, DOCX, HTML, CSV, JSON, XLS" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolCard}" Click="FontBtn_Click">
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="10" Background="#26DB2777">
                        <TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#DB2777"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="FontTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="TTF, OTF, WOFF, WOFF2, EOT" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Button>
        </UniformGrid>
    </Grid>
</UserControl>
