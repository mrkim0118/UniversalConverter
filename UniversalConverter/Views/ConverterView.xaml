<UserControl x:Class="UniversalConverter.Views.ConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" AllowDrop="True"
             DragOver="Root_DragOver" DragLeave="Root_DragLeave" Drop="Root_Drop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: solid accent bar -->
        <Border Grid.Row="0" Background="{DynamicResource AccentBrush}" Padding="20,12">
            <Grid>
                <Button x:Name="BackBtn" Style="{StaticResource HeaderButton}" HorizontalAlignment="Left"
                        Click="Back_Click" AutomationProperties.Name="Back"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" FontSize="18" FontWeight="SemiBold" Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="HeaderFormats" FontSize="11" Foreground="White" Opacity="0.85"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="LangBtn" Style="{StaticResource HeaderButton}" HorizontalAlignment="Right"
                        Click="LangBtn_Click"/>
            </Grid>
        </Border>

        <!-- FFmpeg banner (audio/video only) -->
        <Border x:Name="FFmpegBanner" Grid.Row="1" Margin="24,12,24,0" CornerRadius="8" Padding="16,10"
                Visibility="Collapsed" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FFmpegStatusText" FontSize="13"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button x:Name="FFmpegActionBtn" Grid.Column="1" Style="{StaticResource AccentButton}"
                        Click="FFmpegInstall_Click" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- Drop zone -->
        <Button x:Name="DropZone" Grid.Row="2" HorizontalAlignment="Stretch" Margin="24,12,24,0" Click="PickFiles_Click" Cursor="Hand"
                FocusVisualStyle="{x:Null}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10"/>
                        <Rectangle x:Name="Dash" StrokeDashArray="4 3" Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="1.5"
                                   RadiusX="10" RadiusY="10"/>
                        <ContentPresenter HorizontalAlignment="Center" Margin="16,14"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentTintBrush}"/>
                            <Setter TargetName="Dash" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentTintBrush}"/>
                            <Setter TargetName="Dash" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="drag">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentTintBrush}"/>
                            <Setter TargetName="Dash" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="DropText" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <!-- From / To and the single convert action -->
        <Grid Grid.Row="3" Margin="24,14,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="FromLabel" Style="{StaticResource Label}"/>
                <ComboBox x:Name="FromCombo" MinWidth="140" Height="34" FontSize="13" SelectionChanged="From_Changed"/>
                <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="14,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="ToLabel" Style="{StaticResource Label}"/>
                <ComboBox x:Name="ToCombo" MinWidth="140" Height="34" FontSize="13" SelectionChanged="To_Changed"/>
            </StackPanel>
            <Button x:Name="ConvertBtn" Grid.Column="2" Style="{StaticResource AccentButton}"
                    Padding="28,8" FontSize="14" Click="Convert_Click"/>
        </Grid>

        <!-- Converter-specific settings -->
        <Border x:Name="SettingsBox" Grid.Row="4" Margin="24,12,24,0" CornerRadius="8" Padding="14,10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <ContentControl x:Name="SettingsHost" Focusable="False"/>
        </Border>

        <!-- Files waiting to be converted -->
        <Border Grid.Row="5" Margin="24,12,24,12" CornerRadius="8" Padding="14,10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock x:Name="FilesTitle" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button x:Name="ClearBtn" Style="{StaticResource FlatButton}" HorizontalAlignment="Right"
                            Padding="10,3" Click="Clear_Click" Visibility="Collapsed"/>
                </Grid>
                <TextBlock x:Name="FilesEmpty" Grid.Row="1" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,8,0,0" TextWrapping="Wrap"/>
                <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl x:Name="FilesList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource AccentTintBrush}" CornerRadius="4" Padding="6,1"
                                            Margin="0,0,10,0" MinWidth="44" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Format}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Path}" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="2" Style="{StaticResource SubtleButton}" Tag="{Binding Path}"
                                            Click="RemoveFile_Click" Padding="8,3"
                                            Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            AutomationProperties.Name="{Binding Name, StringFormat='Remove {0}'}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="20,8"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel>
                <ProgressBar x:Name="ConversionProgress" Style="{StaticResource FlatProgressBar}" Maximum="100"
                             Visibility="Collapsed" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="OutDirBtn" Grid.Column="1" Style="{StaticResource SubtleButton}" Padding="10,4" Click="OutDir_Click"/>
                    <Button x:Name="OutDirResetBtn" Grid.Column="2" Style="{StaticResource SubtleButton}" Padding="8,4" Click="OutDirReset_Click"
                            Visibility="Collapsed" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
